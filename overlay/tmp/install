#!/usr/bin/nu

use bf

# Setup and install dependencies
def main [] {
    # add postgres user
    bf user add postgres

    # install basic PostgreSQL dependencies
    bf write "Installing PostgreSQL dependencies."
    bf pkg install [
        "icu-libs"
        "libcrypto3"
        "libldap"
        "lz4-libs"
        "libpq"
        "libssl3"
        "libxml2"
        "postgresql-common"
        "tzdata"
        "zlib"
        "zstd-libs"
    ]

    # making upgrade script executable
    ^chmod +x /upgrade
}
